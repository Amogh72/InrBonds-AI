# Pick ONE provider and fill in its key; the other block can stay empty.
# --provider defaults to anthropic (or LLM_PROVIDER below) - pass
# --provider gemini on the CLI, or set LLM_PROVIDER=gemini here, to use
# Gemini instead. See llm_clients/gemini_client.py's docstring for why
# Gemini is offered as a free-tier-friendly alternative: Anthropic's API
# has no free tier, Gemini's Flash models do (get a key at
# aistudio.google.com - check current free-tier model availability there,
# it changes).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
