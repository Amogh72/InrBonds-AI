# --- MySQL (structured bond data) ---
SQL_HOST=localhost
SQL_PORT=3306
SQL_DATABASE=inrbonds
SQL_USER=mcp_readonly
SQL_PASSWORD=changeme
SQL_DIALECT=mysql

# --- Qdrant (semantic search) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bond_documents
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768

# --- Neo4j (relationships) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- MCP server ---
MCP_SERVER_NAME=inrbonds-document-assistant
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MAX_ROWS_RETURNED=200
QUERY_TIMEOUT_SECONDS=15
